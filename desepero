EXEMPLO DE TESTE ANOVA 

# Instalar e carregar pacotes necessários
if (!require(MASS)) install.packages("MASS")
if (!require(ggplot2)) install.packages("ggplot2")
library(MASS)
library(ggplot2)

# Carregar os dados
data(epil)

# Transformar 'period' e 'trt' em fatores
epil$period <- factor(epil$period)
epil$trt <- factor(epil$trt)

# ANOVA de duas vias com interação
anova <- aov(y ~ trt * period, data = epil)

# Ver resultados da ANOVA
summary(anova)

# Gráfico de interação
interaction.plot(epil$period, epil$trt, epil$y,
                 main = "Interação entre Tratamento e Período",
                 xlab = "Período",
                 ylab = "Número médio de convulsões",
                 trace.label = "Tratamento")

# Boxplot
ggplot(epil, aes(x = period, y = y, fill = trt)) +
  geom_boxplot(position = position_dodge(0.8)) +
  labs(title = "Número de Convulsões por Tratamento e Período",
       x = "Período", y = "Número de Convulsões") +
  theme_minimal()


